<launch>

	<!-- Start the score tracker -->
	</include file="$(find enph353_utils)/launch/score_tracker.launch"/>

    <!-- Start clueboard detection and scoreboard publishing Note: setting output to screen means my print messages will show up in the terminal-->
    <node pkg="clueboard_detection" type="clueboard_detection.py" name="clueboard_finder_node" output="screen">
    </node>

    <!-- Start driving Note: setting output to screen means my print messages will show up in the terminal -->
    <node pkg="minimum_drive" type="minimum_drive.py" name="driving_node" output="screen">
    </node>

</launch>